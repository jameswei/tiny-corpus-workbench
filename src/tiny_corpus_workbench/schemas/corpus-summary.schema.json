{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcw/corpus-summary.schema.json",
  "title": "tiny-corpus-workbench generated corpus summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_id",
    "snapshot_id",
    "run_id",
    "status",
    "totals",
    "by_family",
    "by_format",
    "extractors",
    "comparisons",
    "findings",
    "revision_groups",
    "revisions",
    "members"
  ],
  "properties": {
    "corpus_id": {
      "$ref": "#/$defs/id"
    },
    "snapshot_id": {
      "$ref": "#/$defs/hash"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "FAILED"
      ]
    },
    "totals": {
      "type": "object"
    },
    "by_family": {
      "type": "array"
    },
    "by_format": {
      "type": "array"
    },
    "extractors": {
      "type": "array"
    },
    "comparisons": {
      "type": "array"
    },
    "findings": {
      "type": "array"
    },
    "revision_groups": {
      "type": "array"
    },
    "revisions": {
      "type": "array"
    },
    "members": {
      "type": "array",
      "minItems": 1
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
