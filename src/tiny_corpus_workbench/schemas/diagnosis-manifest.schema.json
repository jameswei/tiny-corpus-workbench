{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcw/diagnosis-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "format_version",
    "run_id",
    "diagnosis_id",
    "created_at",
    "status",
    "source",
    "subject",
    "ruleset",
    "summary",
    "artifacts"
  ],
  "properties": {
    "record_type": {"const": "diagnosis"},
    "format_version": {"const": 1},
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "diagnosis_id": {
      "$ref": "#/$defs/hash"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "FINDINGS",
        "NO_FINDINGS"
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identity_type",
        "identity_value",
        "run_id",
        "manifest_sha256",
        "canonical_document_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "OBSERVATION",
            "REFINEMENT"
          ]
        },
        "identity_type": {
          "enum": [
            "observation_id",
            "revision_id"
          ]
        },
        "identity_value": {
          "$ref": "#/$defs/hash"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "#/$defs/hash"
        },
        "canonical_document_sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "OBSERVATION"
              }
            }
          },
          "then": {
            "properties": {
              "identity_type": {
                "const": "observation_id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "REFINEMENT"
              }
            }
          },
          "then": {
            "properties": {
              "identity_type": {
                "const": "revision_id"
              }
            }
          }
        }
      ]
    },
    "ruleset": {
      "$ref": "#/$defs/ruleset"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "name", "version", "severity", "parameters"],
      "properties": {
        "rule_id": {
          "enum": [
            "TCW-D001",
            "TCW-D002",
            "TCW-D003",
            "TCW-D004",
            "TCW-D005",
            "TCW-D006",
            "TCW-D007",
            "TCW-D008",
            "TCW-D009",
            "TCW-D010"
          ]
        },
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "severity": {"enum": ["ERROR", "WARNING", "INFO"]},
        "parameters": {"type": "object"}
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "parameter_sha256", "rules"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "parameter_sha256": {"$ref": "#/$defs/hash"},
        "rules": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/rule"}
        }
      }
    },
    "count_map": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "by_severity", "by_rule"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "by_severity": {
          "$ref": "#/$defs/count_map",
          "minProperties": 3,
          "maxProperties": 3,
          "propertyNames": {"enum": ["ERROR", "WARNING", "INFO"]}
        },
        "by_rule": {
          "$ref": "#/$defs/count_map",
          "minProperties": 10,
          "maxProperties": 10,
          "propertyNames": {
            "enum": [
              "TCW-D001",
              "TCW-D002",
              "TCW-D003",
              "TCW-D004",
              "TCW-D005",
              "TCW-D006",
              "TCW-D007",
              "TCW-D008",
              "TCW-D009",
              "TCW-D010"
            ]
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "media_type",
        "size",
        "sha256"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "media_type",
        "size",
        "sha256",
        "application_immutable"
      ],
      "properties": {
        "path": {
          "enum": [
            "findings.json",
            "report.md"
          ]
        },
        "role": {
          "enum": [
            "diagnostic-findings",
            "diagnostic-report"
          ]
        },
        "media_type": {
          "enum": [
            "application/json",
            "text/markdown"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "application_immutable": {
          "const": true
        }
      }
    }
  }
}
