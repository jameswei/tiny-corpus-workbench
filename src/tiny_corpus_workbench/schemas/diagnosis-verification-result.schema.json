{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcw/diagnosis-verification-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosis_directory",
    "artifact_integrity",
    "subject_state",
    "derivation_state"
  ],
  "properties": {
    "diagnosis_directory": {
      "type": "string"
    },
    "artifact_integrity": {
      "$ref": "refinement-verification-result.schema.json#/$defs/integrity"
    },
    "subject_state": {
      "$ref": "refinement-verification-result.schema.json#/$defs/external"
    },
    "derivation_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_CHECKED",
            "MATCH",
            "MISMATCH",
            "ERROR"
          ]
        }
      }
    }
  }
}
