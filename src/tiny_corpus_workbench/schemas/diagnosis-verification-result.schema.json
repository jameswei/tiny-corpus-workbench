{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcw/diagnosis-verification-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosis_directory",
    "artifact_integrity",
    "subject_state",
    "derivation_state"
  ],
  "properties": {
    "diagnosis_directory": {
      "type": "string"
    },
    "artifact_integrity": {
      "$ref": "#/$defs/integrity"
    },
    "subject_state": {
      "$ref": "#/$defs/external"
    },
    "derivation_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_CHECKED",
            "MATCH",
            "MISMATCH",
            "ERROR"
          ]
        }
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "path": {"type": ["string", "null"]},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issues"],
      "properties": {
        "status": {
          "enum": ["VERIFIED", "INTEGRITY_MISMATCH", "BROKEN"]
        },
        "issues": {
          "type": "array",
          "items": {"$ref": "#/$defs/issue"}
        }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["NOT_CHECKED", "MATCH", "CHANGED", "MISSING", "ERROR"]
        }
      }
    }
  }
}
