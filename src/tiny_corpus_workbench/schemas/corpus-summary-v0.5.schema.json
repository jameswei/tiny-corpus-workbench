{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcw/corpus-summary-v0.5.schema.json",
  "title": "tiny-corpus-workbench corpus summary v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "snapshot_id",
    "run_id",
    "status",
    "totals",
    "by_family",
    "by_format",
    "extractors",
    "comparisons",
    "findings",
    "revision_groups",
    "revisions",
    "members"
  ],
  "properties": {
    "schema_version": {
      "const": "tcw.corpus-summary/v0.5"
    },
    "corpus_id": {
      "$ref": "corpus-spec-v0.5.schema.json#/$defs/id"
    },
    "snapshot_id": {
      "$ref": "corpus-manifest-v0.5.schema.json#/$defs/hash"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "FAILED"
      ]
    },
    "totals": {
      "$ref": "#/$defs/totals"
    },
    "by_family": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedCounts"
      }
    },
    "by_format": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedCounts"
      }
    },
    "extractors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extractorCounts"
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/findingGroup"
      }
    },
    "revision_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revisionGroup"
      }
    },
    "revisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revisionDetail"
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_count",
        "complete",
        "partial",
        "failed",
        "finding_count",
        "revision_count"
      ],
      "properties": {
        "member_count": {
          "type": "integer",
          "minimum": 1
        },
        "complete": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "revision_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "namedCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "member_count",
        "complete",
        "partial",
        "failed"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "member_count": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "extractorCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "available",
        "unavailable"
      ],
      "properties": {
        "name": {
          "enum": [
            "docling",
            "markitdown"
          ]
        },
        "available": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metricView": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bytes",
            "characters",
            "non_whitespace_characters",
            "lines",
            "non_empty_lines",
            "atx_headings",
            "unordered_list_items",
            "ordered_list_items",
            "pipe_table_rows",
            "visible_urls"
          ],
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "characters": {
              "type": "integer",
              "minimum": 0
            },
            "non_whitespace_characters": {
              "type": "integer",
              "minimum": 0
            },
            "lines": {
              "type": "integer",
              "minimum": 0
            },
            "non_empty_lines": {
              "type": "integer",
              "minimum": 0
            },
            "atx_headings": {
              "type": "integer",
              "minimum": 0
            },
            "unordered_list_items": {
              "type": "integer",
              "minimum": 0
            },
            "ordered_list_items": {
              "type": "integer",
              "minimum": 0
            },
            "pipe_table_rows": {
              "type": "integer",
              "minimum": 0
            },
            "visible_urls": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "metricDeltas": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bytes",
            "characters",
            "non_whitespace_characters",
            "lines",
            "non_empty_lines",
            "atx_headings",
            "unordered_list_items",
            "ordered_list_items",
            "pipe_table_rows",
            "visible_urls",
            "normalized_equal"
          ],
          "properties": {
            "bytes": {
              "type": "integer"
            },
            "characters": {
              "type": "integer"
            },
            "non_whitespace_characters": {
              "type": "integer"
            },
            "lines": {
              "type": "integer"
            },
            "non_empty_lines": {
              "type": "integer"
            },
            "atx_headings": {
              "type": "integer"
            },
            "unordered_list_items": {
              "type": "integer"
            },
            "ordered_list_items": {
              "type": "integer"
            },
            "pipe_table_rows": {
              "type": "integer"
            },
            "visible_urls": {
              "type": "integer"
            },
            "normalized_equal": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_id",
        "status",
        "docling",
        "markitdown",
        "docling_minus_markitdown"
      ],
      "properties": {
        "member_id": {
          "$ref": "corpus-spec-v0.5.schema.json#/$defs/id"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "NOT_AVAILABLE"
          ]
        },
        "docling": {
          "$ref": "#/$defs/metricView"
        },
        "markitdown": {
          "$ref": "#/$defs/metricView"
        },
        "docling_minus_markitdown": {
          "$ref": "#/$defs/metricDeltas"
        }
      }
    },
    "findingGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "severity",
        "family",
        "format",
        "finding_count",
        "affected_member_count"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^TCW-D0(0[1-9]|10)$"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR"
          ]
        },
        "family": {
          "$ref": "corpus-spec-v0.5.schema.json#/$defs/id"
        },
        "format": {
          "enum": [
            "pdf",
            "docx",
            "md",
            "txt"
          ]
        },
        "finding_count": {
          "type": "integer",
          "minimum": 1
        },
        "affected_member_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "revisionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "format",
        "finding_rule",
        "refiner_id",
        "revision_count"
      ],
      "properties": {
        "family": {
          "$ref": "corpus-spec-v0.5.schema.json#/$defs/id"
        },
        "format": {
          "enum": [
            "pdf",
            "docx",
            "md",
            "txt"
          ]
        },
        "finding_rule": {
          "type": "string",
          "pattern": "^TCW-D0(0[1-9]|10)$"
        },
        "refiner_id": {
          "enum": [
            "TCW-R001",
            "TCW-R002",
            "TCW-R003"
          ]
        },
        "revision_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "revisionDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_id",
        "family",
        "format",
        "revision_id",
        "parent",
        "chain_length",
        "finding_id",
        "finding_rule",
        "refiner",
        "affected_reference_count",
        "before_document_sha256",
        "after_document_sha256"
      ],
      "properties": {
        "member_id": {
          "$ref": "corpus-spec-v0.5.schema.json#/$defs/id"
        },
        "family": {
          "$ref": "corpus-spec-v0.5.schema.json#/$defs/id"
        },
        "format": {
          "enum": [
            "pdf",
            "docx",
            "md",
            "txt"
          ]
        },
        "revision_id": {
          "$ref": "#/$defs/hash"
        },
        "parent": {
          "$ref": "corpus-manifest-v0.5.schema.json#/$defs/parent"
        },
        "chain_length": {
          "type": "integer",
          "minimum": 1
        },
        "finding_id": {
          "$ref": "#/$defs/hash"
        },
        "finding_rule": {
          "type": "string",
          "pattern": "^TCW-D0(0[1-9]|10)$"
        },
        "affected_reference_count": {
          "type": "integer",
          "minimum": 1
        },
        "before_document_sha256": {
          "$ref": "#/$defs/hash"
        },
        "after_document_sha256": {
          "$ref": "#/$defs/hash"
        },
        "refiner": {
          "$ref": "refinement-draft-v0.5.schema.json#/$defs/refiner"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_id",
        "family",
        "format",
        "status",
        "error"
      ],
      "properties": {
        "member_id": {
          "$ref": "corpus-spec-v0.5.schema.json#/$defs/id"
        },
        "family": {
          "$ref": "corpus-spec-v0.5.schema.json#/$defs/id"
        },
        "format": {
          "enum": [
            "pdf",
            "docx",
            "md",
            "txt"
          ]
        },
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "FAILED"
          ]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "corpus-manifest-v0.5.schema.json#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
