{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcw/transformation-v0.5.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transformation_id",
    "state",
    "parent",
    "revision_id",
    "finding_id",
    "decision_id",
    "decided_by",
    "refiner",
    "affected_refs",
    "forward_edits",
    "inverse_edits",
    "prepared_document_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "tcw.transformation/v0.5"
    },
    "transformation_id": {
      "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
    },
    "state": {
      "const": "APPLIED"
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject_id",
        "canonical_document_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "OBSERVATION",
            "REVISION"
          ]
        },
        "subject_id": {
          "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
        },
        "canonical_document_sha256": {
          "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
        }
      }
    },
    "revision_id": {
      "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
    },
    "finding_id": {
      "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
    },
    "decision_id": {
      "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
    },
    "decided_by": {
      "type": "string",
      "minLength": 1
    },
    "refiner": {
      "$ref": "refinement-draft-v0.5.schema.json#/$defs/refiner"
    },
    "affected_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^#/"
      }
    },
    "forward_edits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "refinement-draft-v0.5.schema.json#/$defs/edit"
      }
    },
    "inverse_edits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "refinement-draft-v0.5.schema.json#/$defs/edit"
      }
    },
    "prepared_document_sha256": {
      "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
    }
  }
}
