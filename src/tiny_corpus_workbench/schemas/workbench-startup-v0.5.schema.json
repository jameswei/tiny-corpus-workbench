{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcw/workbench-startup-v0.5.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "session_id",
    "url",
    "api_url",
    "record_count",
    "top_level_record_count",
    "contained_record_count",
    "runtime"
  ],
  "properties": {
    "schema_version": {
      "const": "tcw.workbench-startup/v0.5"
    },
    "status": {
      "const": "READY"
    },
    "session_id": {
      "$ref": "https://example.invalid/tcw/common-v0.5.schema.json#/$defs/hash"
    },
    "url": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:(?:10(?:2[4-9]|[3-9][0-9])|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/$"
    },
    "api_url": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:(?:10(?:2[4-9]|[3-9][0-9])|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/api/v0\\.5/workbench$"
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "top_level_record_count": {
      "type": "integer",
      "minimum": 1
    },
    "contained_record_count": {
      "type": "integer",
      "minimum": 0
    },
    "runtime": {
      "$ref": "https://example.invalid/tcw/common-v0.5.schema.json#/$defs/API_RUNTIME_DISPLAY"
    }
  }
}
