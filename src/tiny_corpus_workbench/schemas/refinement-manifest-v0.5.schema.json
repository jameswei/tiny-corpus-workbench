{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcw/refinement-manifest-v0.5.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "status",
    "revision_id",
    "origin_observation_id",
    "origin_observation_run_id",
    "source",
    "base",
    "draft_id",
    "artifacts",
    "diagnosis",
    "parent",
    "build_provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "tcw.refinement-manifest/v0.5"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "APPLIED",
        "REJECTED"
      ]
    },
    "revision_id": {
      "oneOf": [
        {
          "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin_observation_id": {
      "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
    },
    "origin_observation_run_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "diagnosis-manifest-v0.5.schema.json#/$defs/source"
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identity_type",
        "identity_value",
        "run_id",
        "base_manifest_sha256",
        "canonical_document_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "OBSERVATION",
            "REFINEMENT"
          ]
        },
        "identity_type": {
          "enum": [
            "observation_id",
            "revision_id"
          ]
        },
        "identity_value": {
          "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "base_manifest_sha256": {
          "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
        },
        "canonical_document_sha256": {
          "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "OBSERVATION"
              }
            }
          },
          "then": {
            "properties": {
              "identity_type": {
                "const": "observation_id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "REFINEMENT"
              }
            }
          },
          "then": {
            "properties": {
              "identity_type": {
                "const": "revision_id"
              }
            }
          }
        }
      ]
    },
    "draft_id": {
      "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "media_type",
          "size",
          "sha256",
          "application_immutable"
        ],
        "properties": {
          "path": {
            "enum": [
              "decision.json",
              "report.md",
              "transformation.json",
              "history.json",
              "prepared/document.json",
              "prepared/document.md"
            ]
          },
          "role": {
            "enum": [
              "refinement-decision",
              "refinement-report",
              "transformation",
              "transformation-history",
              "prepared-document-json",
              "prepared-document-markdown"
            ]
          },
          "media_type": {
            "enum": [
              "application/json",
              "text/markdown"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
          },
          "application_immutable": {
            "const": true
          }
        }
      }
    },
    "build_provenance": {
      "$ref": "common-v0.5.schema.json#/$defs/BUILD_COMMAND"
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosis_id",
        "run_id",
        "diagnosis_manifest_sha256",
        "findings_artifact_sha256"
      ],
      "properties": {
        "diagnosis_id": {
          "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "diagnosis_manifest_sha256": {
          "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
        },
        "findings_artifact_sha256": {
          "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
        }
      }
    },
    "parent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision_id",
            "run_id",
            "refinement_manifest_sha256",
            "prepared_document_sha256"
          ],
          "properties": {
            "revision_id": {
              "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "refinement_manifest_sha256": {
              "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
            },
            "prepared_document_sha256": {
              "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "APPLIED"
          }
        }
      },
      "then": {
        "properties": {
          "revision_id": {
            "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
          },
          "artifacts": {
            "minItems": 6,
            "maxItems": 6
          }
        }
      },
      "else": {
        "properties": {
          "revision_id": {
            "type": "null"
          },
          "parent": {
            "type": "null"
          },
          "artifacts": {
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "base": {
            "properties": {
              "kind": {
                "const": "OBSERVATION"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "parent": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "APPLIED"
          },
          "base": {
            "properties": {
              "kind": {
                "const": "REFINEMENT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "parent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "revision_id",
              "run_id",
              "refinement_manifest_sha256",
              "prepared_document_sha256"
            ],
            "properties": {
              "revision_id": {
                "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "refinement_manifest_sha256": {
                "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
              },
              "prepared_document_sha256": {
                "$ref": "finding-set-v0.5.schema.json#/$defs/hash"
              }
            }
          }
        }
      }
    }
  ]
}
