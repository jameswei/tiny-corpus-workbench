{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcw/refinement-draft.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal", "decision"],
  "properties": {
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "diagnosis_id",
        "base",
        "finding",
        "refiner",
        "affected_refs",
        "forward_edits",
        "inverse_edits",
        "draft_id"
      ],
      "properties": {
        "state": {"const": "REQUESTED"},
        "diagnosis_id": {"$ref": "#/$defs/hash"},
        "base": {"type": "object"},
        "finding": {"type": "object"},
        "refiner": {"$ref": "#/$defs/refiner"},
        "affected_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^#/"}
        },
        "forward_edits": {"$ref": "#/$defs/edits"},
        "inverse_edits": {"$ref": "#/$defs/edits"},
        "draft_id": {"$ref": "#/$defs/hash"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "decided_by", "note"],
      "properties": {
        "state": {"enum": ["PENDING", "APPROVED", "REJECTED"]},
        "decided_by": {"type": ["string", "null"], "minLength": 1},
        "note": {"type": ["string", "null"], "maxLength": 500}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "refiner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refiner_id", "name", "version"],
      "properties": {
        "refiner_id": {"enum": ["TCW-R001", "TCW-R002", "TCW-R003"]},
        "name": {
          "enum": [
            "WHITESPACE_NORMALIZATION",
            "REPEATED_BOILERPLATE_REMOVAL",
            "DETERMINISTIC_DEHYPHENATION"
          ]
        },
        "version": {"const": "1"}
      }
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "before", "after"],
        "properties": {
          "target": {"$ref": "#/$defs/target"},
          "before": {},
          "after": {}
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "field"],
      "properties": {
        "ref": {"type": "string", "pattern": "^#/"},
        "field": {"enum": ["text", "content_layer"]},
        "row": {"type": "integer", "minimum": 0},
        "column": {"type": "integer", "minimum": 0}
      },
      "dependentRequired": {
        "row": ["column"],
        "column": ["row"]
      }
    }
  }
}
