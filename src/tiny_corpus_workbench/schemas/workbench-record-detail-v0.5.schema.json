          }
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "corpus_id",
            "snapshot_id",
            "summary",
            "contained_record_keys",
            "matrix",
            "aggregates",
            "external_revisions"
          ],
          "properties": {
            "corpus_id": {
              "$ref": "common-v0.5.schema.json#/$defs/identifier"
            },
            "snapshot_id": {
              "$ref": "common-v0.5.schema.json#/$defs/hash"
            },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "totals"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "COMPLETE",
                    "PARTIAL",
                    "FAILED"
                  ]
                },
                "totals": {
                  "$ref": "corpus-summary-v0.5.schema.json#/$defs/totals"
                }
              }
            },
            "contained_record_keys": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "common-v0.5.schema.json#/$defs/hash"
              }
            },
            "matrix": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "member_id",
                  "family",
                  "format",
                  "status",
                  "source",
                  "observation_record_key",
                  "diagnosis_record_key",
                  "error"
                ],
                "properties": {
                  "member_id": {
                    "$ref": "common-v0.5.schema.json#/$defs/identifier"
                  },
                  "family": {
                    "$ref": "common-v0.5.schema.json#/$defs/identifier"
                  },
                  "format": {
                    "enum": [
                      "pdf",
                      "docx",
                      "md",
                      "txt"
                    ]
                  },
                  "status": {
                    "enum": [
                      "COMPLETE",
                      "PARTIAL",
                      "FAILED"
                    ]
                  },
                  "source": {
                    "$ref": "corpus-manifest-v0.5.schema.json#/$defs/source"
                  },
                  "observation_record_key": {
                    "oneOf": [
                      {
                        "$ref": "common-v0.5.schema.json#/$defs/hash"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "diagnosis_record_key": {
                    "oneOf": [
                      {
                        "$ref": "common-v0.5.schema.json#/$defs/hash"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "error": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "code",
                          "message"
                        ],
                        "properties": {
                          "code": {
                            "enum": [
                              "MODEL_ARTIFACTS_MISSING",
                              "MODEL_ARTIFACTS_INVALID",
                              "DOCLING_SERIALIZATION_FAILED",
                              "DOCLING_CONVERSION_FAILED",
                              "MARKITDOWN_CONVERSION_FAILED",
                              "OBSERVATION_FAILED",
                              "OBSERVATION_INCOMPLETE",
                              "CANONICAL_UNAVAILABLE",
                              "DIAGNOSIS_FAILED",
                              "MEMBER_INCOMPLETE"
                            ]
                          },
                          "message": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "COMPLETE"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "observation_record_key": {
                          "type": "string"
                        },
                        "diagnosis_record_key": {
                          "type": "string"
                        },
                        "error": {
                          "type": "null"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "enum": [
                            "PARTIAL",
                            "FAILED"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "error": {
                          "not": {
                            "type": "null"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            },
            "aggregates": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "by_family",
                "by_format",
                "extractors",
                "comparisons",
                "findings",
                "revision_groups",
                "revisions"
              ],
              "properties": {
                "by_family": {
                  "type": "array",
                  "items": {
                    "$ref": "corpus-summary-v0.5.schema.json#/$defs/namedCounts"
                  }
                },
                "by_format": {
                  "type": "array",
                  "items": {
                    "$ref": "corpus-summary-v0.5.schema.json#/$defs/namedCounts"
                  }
                },
                "extractors": {
                  "type": "array",
                  "items": {
                    "$ref": "corpus-summary-v0.5.schema.json#/$defs/extractorCounts"
                  }
                },
                "comparisons": {
                  "type": "array",
                  "items": {
                    "$ref": "corpus-summary-v0.5.schema.json#/$defs/comparison"
                  }
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "$ref": "corpus-summary-v0.5.schema.json#/$defs/findingGroup"
                  }
                },
                "revision_groups": {
                  "type": "array",
                  "items": {
                    "$ref": "corpus-summary-v0.5.schema.json#/$defs/revisionGroup"
                  }
                },
                "revisions": {
                  "type": "array",
                  "items": {
                    "$ref": "corpus-summary-v0.5.schema.json#/$defs/revisionDetail"
                  }
                }
              }
            },
            "external_revisions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "member_id",
                  "revision",
                  "refinement_run_id",
                  "refinement_manifest_sha256",
                  "prepared_document_sha256",
                  "relationship_state",
                  "record_key"
                ],
                "properties": {
                  "member_id": {
                    "$ref": "common-v0.5.schema.json#/$defs/identifier"
                  },
                  "revision": {
                    "$ref": "corpus-summary-v0.5.schema.json#/$defs/revisionDetail"
                  },
                  "refinement_run_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "refinement_manifest_sha256": {
                    "$ref": "common-v0.5.schema.json#/$defs/hash"
                  },
                  "prepared_document_sha256": {
                    "$ref": "common-v0.5.schema.json#/$defs/hash"
                  },
                  "relationship_state": {
                    "enum": [
                      "MATCH",
                      "MISSING"
                    ]
                  },
                  "record_key": {
                    "oneOf": [
                      {
                        "$ref": "common-v0.5.schema.json#/$defs/hash"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "relationship_state": {
                          "const": "MATCH"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "record_key": {
                          "type": "string"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "record_key": {
                          "type": "null"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
