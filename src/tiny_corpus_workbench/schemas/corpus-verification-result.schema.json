{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcw/corpus-verification-result.schema.json",
  "title": "tiny-corpus-workbench generated corpus verification result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_directory",
    "artifact_integrity",
    "specification_state",
    "source_states",
    "model_state",
    "revision_states"
  ],
  "properties": {
    "corpus_directory": {
      "type": "string"
    },
    "artifact_integrity": {
      "$ref": "#/$defs/integrity"
    },
    "specification_state": {
      "type": "object"
    },
    "source_states": {
      "type": "array"
    },
    "model_state": {
      "type": "object"
    },
    "revision_states": {
      "type": "array"
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "path": {"type": ["string", "null"]},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issues"],
      "properties": {
        "status": {
          "enum": ["VERIFIED", "INTEGRITY_MISMATCH", "BROKEN"]
        },
        "issues": {
          "type": "array",
          "items": {"$ref": "#/$defs/issue"}
        }
      }
    }
  }
}
