  "$id": "https://example.invalid/tcw/finding-set-v0.5.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosis_id",
    "subject",
    "ruleset",
    "summary",
    "findings"
  ],
  "properties": {
    "diagnosis_id": {
      "$ref": "#/$defs/hash"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "ruleset": {
      "$ref": "#/$defs/ruleset"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
