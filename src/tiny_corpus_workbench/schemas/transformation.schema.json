{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcw/transformation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transformation_id",
    "state",
    "parent",
    "revision_id",
    "finding_id",
    "decision_id",
    "decided_by",
    "refiner",
    "affected_refs",
    "forward_edits",
    "inverse_edits",
    "prepared_document_sha256"
  ],
  "properties": {
    "transformation_id": {"$ref": "#/$defs/hash"},
    "state": {"const": "APPLIED"},
    "parent": {"$ref": "#/$defs/parent"},
    "revision_id": {"$ref": "#/$defs/hash"},
    "finding_id": {"$ref": "#/$defs/hash"},
    "decision_id": {"$ref": "#/$defs/hash"},
    "decided_by": {"type": "string", "minLength": 1},
    "refiner": {"$ref": "refinement-draft.schema.json#/$defs/refiner"},
    "affected_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^#/"}
    },
    "forward_edits": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "refinement-draft.schema.json#/$defs/edit"}
    },
    "inverse_edits": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "refinement-draft.schema.json#/$defs/edit"}
    },
    "prepared_document_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject_id", "canonical_document_sha256"],
      "properties": {
        "kind": {"enum": ["OBSERVATION", "REVISION"]},
        "subject_id": {"$ref": "#/$defs/hash"},
        "canonical_document_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
