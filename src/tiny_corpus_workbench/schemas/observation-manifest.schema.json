{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcw/observation-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "format_version",
    "run_id",
    "observation_id",
    "created_at",
    "status",
    "source",
    "configurations",
    "docling_document_schema",
    "models",
    "extractors",
    "comparison"
  ],
  "properties": {
    "record_type": {"const": "observation"},
    "format_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "observation_id": {"$ref": "#/$defs/hash"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["SUCCESS", "PARTIAL_SUCCESS", "FAILED"]},
    "source": {"$ref": "#/$defs/source"},
    "configurations": {"$ref": "#/$defs/configurations"},
    "docling_document_schema": {"$ref": "#/$defs/documentSchema"},
    "models": {"$ref": "#/$defs/models"},
    "extractors": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/extractor"},
            {
              "properties": {
                "name": {"const": "docling"},
                "upstream_status": {
                  "enum": ["success", "partial_success", null]
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/extractor"},
            {
              "properties": {
                "name": {"const": "markitdown"},
                "status": {"enum": ["SUCCESS", "FAILED"]},
                "upstream_status": {"type": "null"}
              }
            }
          ]
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "comparison": {"$ref": "#/$defs/comparison"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "name",
        "key",
        "media_type",
        "size",
        "sha256",
        "fixture_id",
        "capture_method"
      ],
      "properties": {
        "path": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "media_type": {
          "enum": [
            "application/pdf",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "text/markdown",
            "text/plain"
          ]
        },
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "fixture_id": {"type": ["string", "null"]},
        "capture_method": {"const": "private-byte-snapshot-v1"}
      }
    },
    "configurations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docling", "markitdown"],
      "properties": {
        "docling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accelerator",
            "ocr",
            "table_structure",
            "remote_services",
            "external_plugins",
            "artifacts_path"
          ],
          "properties": {
            "accelerator": {"const": "cpu"},
            "ocr": {"const": false},
            "table_structure": {"const": true},
            "remote_services": {"const": false},
            "external_plugins": {"const": false},
            "artifacts_path": {"const": "explicit-local-path"}
          }
        },
        "markitdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "convert_method",
            "plugins",
            "llm_client",
            "text_hints"
          ],
          "properties": {
            "convert_method": {"const": "convert_local"},
            "plugins": {"const": false},
            "llm_client": {"const": false},
            "text_hints": {"const": "extension-media-type-utf8"}
          }
        }
      }
    },
    "documentSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": ["string", "null"], "minLength": 1},
        "version": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "modelFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "inventory_hash", "files"],
      "properties": {
        "required": {"type": "boolean"},
        "inventory_hash": {
          "oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
        },
        "files": {
          "type": "array",
          "items": {"$ref": "#/$defs/modelFile"}
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "media_type",
        "size",
        "sha256",
        "application_immutable"
      ],
      "properties": {
        "path": {
          "enum": [
            "docling/document.json",
            "docling/document.md",
            "markitdown/document.md"
          ]
        },
        "role": {
          "enum": [
            "docling-document-json",
            "docling-markdown",
            "markitdown-markdown"
          ]
        },
        "media_type": {"enum": ["application/json", "text/markdown"]},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "application_immutable": {"const": true}
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "MODEL_ARTIFACTS_MISSING",
            "MODEL_ARTIFACTS_INVALID",
            "DOCLING_CONVERSION_FAILED",
            "DOCLING_SERIALIZATION_FAILED",
            "MARKITDOWN_CONVERSION_FAILED",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])[\\s\\S]*$"
        }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "status",
        "duration_ms",
        "upstream_status",
        "artifacts",
        "error"
      ],
      "properties": {
        "name": {"enum": ["docling", "markitdown"]},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["SUCCESS", "PARTIAL_SUCCESS", "FAILED"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "upstream_status": {
          "enum": ["success", "partial_success", null]
        },
        "artifacts": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "error": {"$ref": "#/$defs/error"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "path",
        "size",
        "sha256",
        "application_immutable"
      ],
      "properties": {
        "status": {"enum": ["COMPLETE", "INCOMPLETE", "NOT_AVAILABLE"]},
        "path": {"const": "comparison.json"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "application_immutable": {"const": true}
      }
    }
  }
}
