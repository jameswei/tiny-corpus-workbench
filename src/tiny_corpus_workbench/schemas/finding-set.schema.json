{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcw/finding-set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosis_id",
    "subject",
    "ruleset",
    "summary",
    "findings"
  ],
  "properties": {
    "diagnosis_id": {
      "$ref": "#/$defs/hash"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "ruleset": {
      "$ref": "#/$defs/ruleset"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject_id",
        "canonical_document_path",
        "canonical_document_size",
        "canonical_document_sha256",
        "origin_observation_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "OBSERVATION",
            "REVISION"
          ]
        },
        "subject_id": {
          "$ref": "#/$defs/hash"
        },
        "canonical_document_path": {
          "enum": [
            "docling/document.json",
            "prepared/document.json"
          ]
        },
        "canonical_document_size": {
          "type": "integer",
          "minimum": 1
        },
        "canonical_document_sha256": {
          "$ref": "#/$defs/hash"
        },
        "origin_observation_id": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "name",
        "version",
        "severity",
        "parameters"
      ],
      "properties": {
        "rule_id": {
          "enum": [
            "TCW-D001",
            "TCW-D002",
            "TCW-D003",
            "TCW-D004",
            "TCW-D005",
            "TCW-D006",
            "TCW-D007",
            "TCW-D008",
            "TCW-D009",
            "TCW-D010"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARNING",
            "INFO"
          ]
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "parameter_sha256",
        "rules"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "parameter_sha256": {
          "$ref": "#/$defs/hash"
        },
        "rules": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "count_map": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "by_severity",
        "by_rule"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "by_severity": {
          "$ref": "#/$defs/count_map",
          "minProperties": 3,
          "maxProperties": 3,
          "propertyNames": {
            "enum": [
              "ERROR",
              "WARNING",
              "INFO"
            ]
          }
        },
        "by_rule": {
          "$ref": "#/$defs/count_map",
          "minProperties": 10,
          "maxProperties": 10,
          "propertyNames": {
            "enum": [
              "TCW-D001",
              "TCW-D002",
              "TCW-D003",
              "TCW-D004",
              "TCW-D005",
              "TCW-D006",
              "TCW-D007",
              "TCW-D008",
              "TCW-D009",
              "TCW-D010"
            ]
          }
        }
      }
    },
    "evidence_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "rule_id",
        "rule_version",
        "severity",
        "summary",
        "document_refs",
        "evidence"
      ],
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/hash"
        },
        "rule_id": {
          "enum": [
            "TCW-D001",
            "TCW-D002",
            "TCW-D003",
            "TCW-D004",
            "TCW-D005",
            "TCW-D006",
            "TCW-D007",
            "TCW-D008",
            "TCW-D009",
            "TCW-D010"
          ]
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARNING",
            "INFO"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "document_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^#/"
          }
        },
        "evidence": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/evidence_value"
          }
        }
      }
    }
  }
}
